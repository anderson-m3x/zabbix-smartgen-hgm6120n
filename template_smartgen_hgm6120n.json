    "templates": [
      {
        "uuid": "afc367e6e5dd43f186da1f3d62e6c55e",
        "template": "SmartGen_HGM6120N",
        "name": "SmartGen HGM6120N genset controller (Modbus)",
        "description": "SmartGen HGM6120N/NC — контроллер генераторной установки, данные по Modbus TCP.\n\nЧто внутри: 42 item'а (напряжения сети и генератора, частоты, токи, мощности, давление масла, температура ОЖ, уровень топлива, обороты, напряжение АКБ, наработка, состояние автоматики) и 14 триггеров.\n\nПеред использованием задайте макросы на хосте: {$HGM.HOST} — адрес контроллера, {$HGM.PORT} — порт (502), {$HGM.SLAVE} — slave ID (1).\n\nПрактика, ради которой шаблон и делался:\n- Давление масла и обороты опрашиваются разными item'ами, поэтому на остановке масло успевает отдать 0, а обороты ещё держат прошлое значение. Триггеры по маслу используют окно 3 минуты (max/min), иначе получаются ложные срабатывания на каждом пуске и остановке.\n- Восстановление аварий по маслу учитывает остановку двигателя (rpm<={$HGM.RPM.RUNNING}), иначе проблема висит до следующего пуска.\n- Порог «высокого» давления = 800 кПа: это давление открытия редукционного клапана 6105 по мануалу (0.8 МПа), а не «на глаз».",
        "groups": [
          {
            "name": "Templates"
          }
        ],
        "macros": [
          {
            "macro": "{$HGM.HOST}",
            "value": "192.168.1.10",
            "description": "IP контроллера HGM6120N/NC"
          },
          {
            "macro": "{$HGM.PORT}",
            "value": "502",
            "description": "TCP-порт Modbus (по умолчанию 502)"
          },
          {
            "macro": "{$HGM.SLAVE}",
            "value": "1",
            "description": "Modbus slave ID контроллера"
          },
          {
            "macro": "{$HGM.RPM.RUNNING}",
            "value": "500",
            "description": "Обороты, выше которых двигатель считается работающим"
          },
          {
            "macro": "{$HGM.OIL.LOW}",
            "value": "250",
            "description": "Давление масла, кПа: ниже — проблема (все {$HGM.WINDOW})"
          },
          {
            "macro": "{$HGM.OIL.LOW.REC}",
            "value": "300",
            "description": "Давление масла, кПа: восстановление"
          },
          {
            "macro": "{$HGM.OIL.HIGH}",
            "value": "800",
            "description": "Давление масла, кПа: выше — проблема (упор в редукционный клапан)"
          },
          {
            "macro": "{$HGM.OIL.HIGH.REC}",
            "value": "700",
            "description": "Давление масла, кПа: восстановление для высокой"
          },
          {
            "macro": "{$HGM.TEMP.HIGH}",
            "value": "95",
            "description": "Температура ОЖ, °C: проблема"
          },
          {
            "macro": "{$HGM.TEMP.HIGH.REC}",
            "value": "90",
            "description": "Температура ОЖ, °C: восстановление"
          },
          {
            "macro": "{$HGM.FUEL.LOW}",
            "value": "30",
            "description": "Уровень топлива, %: проблема"
          },
          {
            "macro": "{$HGM.FUEL.LOW.REC}",
            "value": "50",
            "description": "Уровень топлива, %: восстановление"
          },
          {
            "macro": "{$HGM.BATT.LOW}",
            "value": "25",
            "description": "Напряжение АКБ, В: проблема"
          },
          {
            "macro": "{$HGM.BATT.LOW.REC}",
            "value": "25.5",
            "description": "Напряжение АКБ, В: восстановление"
          },
          {
            "macro": "{$HGM.GEN.VOLTAGE}",
            "value": "180",
            "description": "Напряжение генератора, В: выдаёт напряжение"
          },
          {
            "macro": "{$HGM.GEN.VOLTAGE.REC}",
            "value": "50",
            "description": "Напряжение генератора, В: восстановление"
          }
        ],
        "items": [
          {
            "name": "Maintenance Summary",
            "type": "CALCULATED",
            "key": "maintenance.summary",
            "delay": "1h",
            "value_type": "TEXT",
            "params": "last(/SmartGen_HGM6120N/modbus.get[tcp://10.5.95.40:502,1,3,43,3,uint16,be])",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "// value - это сырое значение Engine Runtime в СЕКУНДАХ\nvar seconds = parseFloat(value);\nif (isNaN(seconds)) { \n    return \"Ошибка: нет данных о моточасах\"; \n}\n\n// Переводим секунды в часы\nvar hours = seconds / 3600;\n\nvar text = \"=== СТАТУС ТЕХНИЧЕСКОГО ОБСЛУЖИВАНИЯ ===\\n\\n\";\ntext += \"Текущая наработка: \" + hours.toFixed(1) + \" ч.\\n\\n\";\n\n// Интервалы ТО согласно инструкции (стр. 62-65)\nvar intervals = [250, 500, 1000];\n\nintervals.forEach(function(interval) {\n    // Вычисляем остаток до следующего интервала\n    var rem = interval - (hours % interval);\n    \n    // Если остаток равен самому интервалу, значит мы ровно на отметке (например, 250)\n    if (rem === interval) { rem = 0; }\n\n    text += \"До ТО-\" + interval + \"ч: \";\n    \n    if (rem <= 20) {\n        text += \"⚠️ ВЫПОЛНИТЬ В БЛИЖАЙШЕЕ ВРЕМЯ (осталось \" + rem.toFixed(1) + \" ч.)\\n\";\n    } else if (rem <= 50) {\n        text += \"🟡 Скоро (осталось \" + rem.toFixed(1) + \" ч.)\\n\";\n    } else {\n        text += \"🟢 В норме (осталось \" + rem.toFixed(1) + \" ч.)\\n\";\n    }\n});\n\ntext += \"\\n=== ПРОВЕРИТЬ ЗАКУПКУ РАСХОДНИКОВ ===\\n\";\ntext += \"• Масло моторное 10W40 (18 л)\\n\";\ntext += \"• Фильтр масляный (JX0818)\\n\";\ntext += \"• Фильтр топливный (CS0708B)\\n\";\ntext += \"• Фильтр воздушный (K2139)\\n\";\ntext += \"• Ремень генератора\\n\";\ntext += \"\\n⚠️ ВАЖНО: Не забывайте про ежегодное ТО (не реже 1 раза в год), независимо от наработки!\";\n\nreturn text;"
                ]
              }
            ]
          },
          {
